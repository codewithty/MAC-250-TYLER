Table user_Account{
    account_id int [pk]
    email varchar [not null]
    password varchar [not null]
    phone_number varchar
    subscription_id int [ref: > subscription.subscription_id]
}

Table subscription{
    subscription_id int [pk]
    subscription_type varchar [not null]
    subscription_price decimal [not null]
    subscription_duration int [not null]
}

Table profile{
    account_id int [ref: > user_Account.account_id]
    profile_id int [pk]
    profile_name varchar [not null]
    profile_picture varchar
    is_kid_profile boolean [not null]
}

Table is_watched{
    profile_id int [ref: > profile.profile_id]
    is_watched boolean [not null]
    film_id int [ref: > film.film_id]
    tv_show_id int [ref: > tv_show.show_id]
}

Table is_liked{
    profile_id int [ref: > profile.profile_id]
    is_liked boolean [not null]
    film_id int [ref: > film.film_id]
    tv_show_id int [ref: > tv_show.show_id]
}

Table film{
    film_id int [pk]
    film_title varchar [not null]
    film_description varchar [not null]
    film_length int [not null]
}

Table tv_show{
    show_id int [pk]
    show_title varchar [not null]
    show_description varchar [not null]
    show_length int [not null]

}

Table actor{
    actor_id int [pk]
    actor_name varchar [not null]
    age int
}

Table director{
    director_id int [pk]
    first_name varchar [not null]
    last_name varchar [not null]
    age int
}

Table film_actors{
    film_id int [ref: > film.film_id] //FK
    actor_id int [ref: > actor.actor_id] //FK
    film_length int
}

Table tv_actors{
    show_id int [ref: > tv_show.show_id] //FK
    actor_id int [ref: > actor.actor_id] //FK
}

Table film_directors{
    film_director_id int [not null] //FK
    film_id int [not null] //FK
}

Table tv_directors{
    tv_director_id int [not null] //FK
    show_id int [ref: > tv_show.show_id] //FK
}
Ref film_actors: film_actors.actor_id > actor.actor_id
Ref tv_actors: tv_actors.actor_id > actor.actor_id

Ref film_directors: film_directors.director_id > director.director_id
Ref tv_directors: tv_directors.tv_director_id > director.director_id

Ref film_actors: film_actors.film_id > film.film_id
Ref film_directors: film_directors.film_id > film.film_id

Ref tv_actors: tv_actors.show_id > tv_show.show_id
Ref tv_directors: tv_directors.show_id > tv_show.show_id